rules_version = '2';

// Security Rules für den verifizierten Anonymchat.
//
// Hier wird entschieden, wer was darf – nicht im Browser. Was nicht
// ausdrücklich erlaubt ist, ist verboten.
//
// Deployen: firebase deploy --only firestore:rules,firestore:indexes
// oder über den GitHub-Ablauf "Firebase-Regeln ausrollen".

service cloud.firestore {
  match /databases/{database}/documents {

    // Zwei Rollen, weil sie Unterschiedliches anrichten können.
    //
    // Verwaltung: alles, was Moderation darf, plus Tarife vergeben und
    // Daten löschen. Moderation: Verifizierungen entscheiden, Meldungen und
    // Verläufe lesen, Konten sperren – die tägliche Arbeit.
    //
    // Dieselben Listen stehen in `src/services/roles.ts` (für die Anzeige)
    // und in `storage.rules`. Sie müssen zusammenpassen: Wer nur dort
    // eingetragen ist, sieht die Oberfläche und bekommt hier eine Absage.
    //
    // Sobald es mehr als eine Handvoll Kennungen sind: auf Custom Claims
    // umstellen (request.auth.token.rolle), dann braucht eine Änderung kein
    // Deployment mehr.
    function istVerwaltung() {
      return request.auth != null
        && request.auth.uid in [
          'RwwpyDrsJldCIx38BcBHVsgTXc32'
        ];
    }

    function istModeration() {
      return istVerwaltung()
        || (request.auth != null
            && request.auth.uid in [
              'PLATZHALTER_KEINE_WEITEREN_MODERATOREN'
            ]);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Verifiziert und nicht gesperrt: die Bedingung für alles, was mit
    // anderen Menschen zu tun hat. Beide Prüfungen laufen auf dem Server –
    // eine gesperrte Person kommt damit auch dann nicht in die
    // Warteschlange, wenn sie den Browsercode umschreibt.
    function kontoDa() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // `verificationStatus` ist die einzige Wahrheit über den Prüfstand.
    // Früher stand daneben ein zweites Feld `verified`; zwei Felder, die
    // dasselbe bedeuten, laufen auseinander – dann darf jemand chatten und
    // wird als ungeprüft angezeigt, oder umgekehrt.
    function darfChatten() {
      return kontoDa()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationStatus == 'verifiziert'
        && !exists(/databases/$(database)/documents/blocked/$(request.auth.uid));
    }

    // Das eigene Konto: anlegen und pflegen darf man es selbst, lesen darf
    // es zusätzlich die Moderation.
    //
    // Zwei Felder sind ausgenommen. `verificationStatus` entscheidet über
    // den Zugang zum Chat – ein Konto, das sich selbst auf 'verifiziert'
    // setzen könnte, macht die ganze Prüfung sinnlos. Und `membership`
    // ebenso, solange die Kasse fehlt: Ein Browser darf über einen
    // bezahlten Zugang nicht selbst entscheiden.
    //
    // Der Antragsstand gehört dagegen halb der Person: Einreichen ('wartet')
    // und Zurückziehen ('offen') sind ihre Entscheidung. 'verifiziert' und
    // 'abgelehnt' bleiben der Moderation vorbehalten.
    function eigenerAntragsstand() {
      return request.resource.data.verificationStatus in ['offen', 'wartet'];
    }

    /**
     * Was die Moderation am Konto ändern darf – und sonst nichts.
     *
     * Neben dem Prüfstand ist das die Geschlechtsangabe samt Name: Sie wird
     * einmal gesetzt und danach nur noch auf Anfrage korrigiert. Tarif,
     * Profil und Sperrlisten bleiben aussen vor.
     */
    function nurModerationsfelder() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['verificationStatus', 'verifiedAt', 'geschlecht', 'pseudonym']);
    }

    /**
     * Die Geschlechtsangabe gehört der Person – aber nur einmal.
     *
     * Sie bestimmt die Form des Zufallsnamens, der im Chat das Einzige ist,
     * was über das Gegenüber etwas aussagt. Liesse er sich jederzeit
     * umstellen, wäre die Angabe beliebig und damit wertlos.
     */
    function geschlechtGesetztOderGleich() {
      return request.resource.data.get('geschlecht', null) == resource.data.get('geschlecht', null)
        || (resource.data.get('geschlecht', null) == null
            && request.resource.data.get('geschlecht', null) in ['weiblich', 'maennlich']);
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.verificationStatus == 'offen'
        && request.resource.data.membership.plan == 'frei';
      allow read: if istModeration() || isOwner(userId);
      allow update: if istVerwaltung()
        // Moderation entscheidet über die Verifizierung – nicht über Tarife.
        || (istModeration() && nurModerationsfelder())
        || (isOwner(userId)
            && request.resource.data.membership == resource.data.membership
            && geschlechtGesetztOderGleich()
            && (request.resource.data.verificationStatus == resource.data.verificationStatus
                || eigenerAntragsstand()));
      allow delete: if false;
    }

    // Tarifwünsche.
    //
    // Ein Wunsch ist kein Zugang: Freigeschaltet wird über
    // `users.membership`, und das kann nur die Moderation. Hier steht
    // lediglich, wer was möchte – damit die Moderation weiss, wen sie nach
    // dem Zahlungseingang freischalten muss.
    match /planRequests/{userId} {
      allow read: if istModeration() || isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.erledigt == false;
      // Abhaken gehört zur Tarifvergabe und damit zur Verwaltung.
      allow update, delete: if istVerwaltung();
      allow delete: if isOwner(userId);
    }

    // Verifizierungsanträge: einreichen darf man für sich selbst, lesen den
    // eigenen Stand – entscheiden nur die Moderation. Zurückziehen ist
    // erlaubt, solange noch nicht entschieden wurde.
    match /verifications/{requestId} {
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.status == 'wartet';
      allow read: if istModeration() || isOwner(resource.data.userId);
      allow update: if istModeration();
      allow delete: if istModeration() || (isOwner(resource.data.userId) && resource.data.status == 'wartet');
    }

    // Meldungen: absenden darf jede angemeldete Person, lesen nur die Moderation.
    match /reports/{reportId} {
      allow create: if isOwner(request.resource.data.reporterId)
        && request.resource.data.status == 'offen';
      allow read, update, delete: if istModeration();
    }

    // Warteschlange.
    //
    // Sie ist für alle Suchenden lesbar – anders lässt sich ohne eigenen
    // Server niemand finden. Darin steht deshalb nur, was das Gegenüber
    // ohnehin sehen wird: Pseudonym, Sprache, Interessen. Keine Kennung
    // ausserhalb der Konto-ID, keine Nummer, keine Adresse.
    //
    // Den fremden Eintrag darf man genau einmal anfassen: um die Nummer des
    // gemeinsamen Raums einzutragen, und nur solange dort noch keine steht.
    match /queue/{userId} {
      allow read: if darfChatten() || istModeration();
      allow create: if isOwner(userId)
        && darfChatten()
        && request.resource.data.uid == userId
        && request.resource.data.roomId == null;
      allow update: if (isOwner(userId) && request.resource.data.uid == userId)
        || (darfChatten()
            && resource.data.roomId == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roomId'])
            && request.resource.data.roomId is string);
      allow delete: if isOwner(userId) || istModeration();
    }

    // Chaträume. Lesen und schreiben darf nur, wer darin steht – die
    // Moderation zusätzlich, solange die 72 Stunden laufen.
    match /chats/{chatId} {
      function teilnehmer() {
        return isSignedIn() && resource.data.participants.hasAny([request.auth.uid]);
      }

      allow create: if darfChatten()
        && request.resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.participants.size() == 2
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time;

      // Einzelabruf: nach Ablauf der Frist sieht ihn auch die Moderation nicht mehr.
      allow get: if teilnehmer() || (istModeration() && resource.data.expiresAt > request.time);

      // Auflisten: Die Bedingung oben lässt sich für eine Abfrage nicht
      // prüfen – Firestore kann den Zeitwert des Clients nicht verifizieren
      // und würde jede Liste ablehnen. Die Übersicht ist deshalb der
      // Moderation ohne Zeitbedingung erlaubt; abgelaufene Räume filtert
      // die App heraus und die TTL-Richtlinie löscht sie.
      allow list: if istModeration();
      // Vorzeitiges Löschen ist Moderationsarbeit – und steht im Protokoll.
      allow delete: if istModeration();

      // Im laufenden Gespräch ändern sich nur Zähler und Zustände. Wer
      // darin sitzt, kann weder die Beteiligten noch die Frist verschieben.
      allow update: if istModeration()
        || (teilnehmer()
            && request.resource.data.participants == resource.data.participants
            && request.resource.data.expiresAt == resource.data.expiresAt
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['typing', 'seen', 'left', 'endedAt', 'messageCount', 'flagCount', 'reported']));

      match /messages/{messageId} {
        function imRaum() {
          return isSignedIn()
            && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
        }

        // Niemand schreibt im fremden Namen, und keine Nachricht ohne Frist.
        allow create: if imRaum()
          && request.resource.data.author == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.expiresAt is timestamp;
        allow read: if imRaum() || istModeration();
        // Geschriebenes bleibt stehen: Nachträgliches Ändern würde jeden
        // Verlauf als Beweismittel wertlos machen.
        allow update: if false;
        allow delete: if istModeration();
      }
    }

    // Abfrage über alle Nachrichten hinweg – nur für das Aufräumen durch
    // die Moderation. Ohne diese Regel scheitert jede Collection-Group-Abfrage.
    match /{pfad=**}/messages/{messageId} {
      allow read, delete: if istModeration();
    }

    // Sperrliste: gepflegt und gelesen von der Moderation. Durchgesetzt wird
    // sie oben in `darfChatten()`; dafür braucht niemand Leserecht.
    match /blocked/{userId} {
      allow read, write: if istModeration();
    }

    // Zugriffsprotokoll: Einträge entstehen beim Öffnen und Löschen eines
    // Verlaufs. Anlegen darf sie nur die Moderation, ändern und löschen
    // niemand – ein Protokoll, das sich aufräumen lässt, ist keines.
    //
    // Solange es keinen Server gibt, schreibt der Client die Einträge. Das ist
    // die schwächste Stelle dieser Regeln: Wer die Moderationsrechte hat,
    // könnte den Eintrag umgehen. Mit einer Cloud Function gehört das
    // Schreiben auf die Serverseite.
    match /accessLog/{entryId} {
      allow read: if istModeration();
      allow create: if istModeration();
      // Für niemanden, auch nicht für die Verwaltung. Ein Protokoll, das
      // sich aufräumen lässt, ist keines – und der Sinn dieses Protokolls
      // ist, die Moderation selbst nachvollziehbar zu machen.
      allow update, delete: if false;
    }
  }
}
