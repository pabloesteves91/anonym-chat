rules_version = '2';

// Security Rules für Ausweisfotos und Selfies.
//
// Grundsatz: Diese Bilder sind das Heikelste im ganzen System. Hochladen darf
// sie nur die Person selbst, ansehen nur die Moderation, und nach dem Entscheid
// werden sie gelöscht (Lebenszyklusregel im Bucket, zusätzlich zum Löschen
// durch die App).
//
// Deployen mit: firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {

    // Dieselben Listen wie in `firestore.rules` und `src/services/roles.ts`.
    // Ausweisbilder darf jede moderierende Person sehen – das ist ihre
    // Arbeit; getrennte Rollen gibt es hier deshalb nicht.
    function istModeration() {
      return request.auth != null
        && request.auth.uid in [
          'RwwpyDrsJldCIx38BcBHVsgTXc32'
        ];
    }

    match /verifications/{userId}/{datei} {
      // Nur eigene Bilder, nur Bilder, höchstens 12 MB.
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Die hochladende Person sieht ihre eigene Vorschau, sonst nur die Moderation.
      allow read: if istModeration() || (request.auth != null && request.auth.uid == userId);
      allow delete: if istModeration();
    }

    // Alles andere ist gesperrt.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
